---
/**
 * 製品 LP（pattern: 'product'）を Astro の静的レンダリングで出す。
 *
 * README の Setup が謳う「1行導入」をそのまま踏む —— スタイルの導入は
 * 次の import 1本だけで、Tailwind も PostCSS 設定も消費側に要らない。
 */
import '@siracusahq/gtm-design-system/styles.css';
import { LandingPage, defineLandingPage } from '@siracusahq/gtm-design-system';

const page = defineLandingPage({
  pattern: 'product',
  brand: 'peerdesk-taxpeer',
  header: {
    logo: 'タックスピア',
    navItems: [
      { label: '機能', href: '#features' },
      { label: '料金', href: '#pricing' },
    ],
    actions: [{ label: '資料をダウンロード', href: '/contact' }],
  },
  hero: {
    badge: '税理士事務所 向け',
    title: '税務書類の収集を、追いかけずに終わらせる。',
    subtitle:
      'タックスピアは、税理士事務所と顧問先をつなぐ書類収集ツールです。未提出の催促も、進捗の確認も、自動で回ります。',
    offers: [
      { label: '資料をダウンロード', href: '/contact' },
      { label: '料金を見る', href: '#pricing' },
    ],
  },
  /* 実績数値には基準時点が要る（景表法。asOf も note も無いと dev 警告） */
  proof: {
    stats: {
      stats: [
        { value: '800', suffix: '事務所', label: '導入実績', numericValue: 800 },
        { value: '92', suffix: '%', label: '期限内回収率', numericValue: 92 },
        { value: '3', suffix: '日', label: '平均導入期間', numericValue: 3 },
      ],
      asOf: '※2026年7月末時点',
    },
  },
  features: {
    eyebrow: 'Features',
    title: '書類回収の「催促する仕事」をなくす',
    features: [
      { title: '自動リマインド', description: '未提出の顧問先に、期日から逆算して自動で催促します。' },
      { title: '進捗ボード', description: '全顧問先の提出状況が一枚のボードで見えます。' },
      { title: '顧問先アプリ不要', description: '顧問先はメールのリンクから撮影・アップロードするだけ。' },
    ],
  },
  /* CTABand（強調面）を1本挟む。verify.mjs が cta_band_band クラスを探す */
  midCta: { title: 'まずは資料からご覧ください', note: '無料・1分で完了' },
  pricing: {
    eyebrow: 'Pricing',
    title: '料金プラン',
    plans: [
      {
        name: 'スタンダード',
        price: '¥30,000',
        priceUnit: '/月',
        features: [
          { text: '顧問先 100件まで', included: true },
          { text: '自動リマインド', included: true },
        ],
        action: { label: '資料をダウンロード', href: '/contact' },
      },
      {
        name: 'プロフェッショナル',
        price: '¥50,000',
        priceUnit: '/月',
        badge: '人気',
        highlighted: true,
        features: [
          { text: '顧問先 無制限', included: true },
          { text: '会計ソフト連携', included: true },
        ],
        action: { label: '資料をダウンロード', href: '/contact' },
      },
    ],
  },
  closing: {
    kicker: '＼5分でわかる資料をプレゼント／',
    title: 'まずは資料からご覧ください',
    socialProof: '800事務所が利用中',
  },
});
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>タックスピア | Astro 消費側結合テスト</title>
  </head>
  <body>
    <LandingPage {...page} />
  </body>
</html>
